# MikuHost Lifeform — salin ke .env lalu sesuaikan. Jangan commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=8888

# Domain publik (nginx). BASE_PATH dipakai karena domain ini sudah melayani
# aplikasi lain (MikuChat di /, MikuHost API di /apidv/, MikuRemote di /mikuremote/).
PUBLIC_BASE_URL=https://ashimusic.biz.id
BASE_PATH=/lifeform

DATA_DIR=./data
CORS_ORIGINS=

# Opsional: login password selain pairing code. Kosongkan untuk menonaktifkan.
OWNER_PASSWORD=
PAIRING_TTL_MS=600000
ACCESS_TOKEN_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=2592000000
MAX_DEVICES=10

# AI engine — memakai project mikuhost-agent yang sudah ada (bukan engine baru).
MIKUHOST_AGENT_HOME=/root/mikuhost-agent
LIFEFORM_WORKSPACE=/root
AI_TIMEOUT_MS=180000
AI_MAX_ITERATIONS=12
AI_TEMPERATURE=0.6
AI_STREAMING=true

# Monitoring
MONITOR_INTERVAL_MS=15000
METRICS_RETENTION_DAYS=7
# CPU: one sampler owns /proc/stat; consumers read the cached value.
CPU_SAMPLE_INTERVAL_MS=5000
CPU_SAMPLE_STALE_MS=30000
THRESHOLD_CPU=85
THRESHOLD_MEMORY=90
THRESHOLD_DISK=90
# A breach must hold this long before an alert opens; it resolves once the
# value drops below (threshold - ALERT_RESOLVE_MARGIN).
ALERT_SUSTAIN_MS=60000
ALERT_RESOLVE_MARGIN=5
PROCESS_LIMIT=20

# Lifeform behaviour
AUTONOMY_LEVEL=1
AWARENESS_INTERVAL_MS=60000
REFLECTION_INTERVAL_MS=900000
APPROVAL_TTL_MS=900000
COMMAND_TIMEOUT_MS=30000

NODE_ID=primary
NODE_NAME=Primary Node

# Remote control (SFTP/SSH + PTY). Kredensial server disimpan terenkripsi
# dengan kunci di data/remote.key dan tidak pernah dikirim ke klien.
REMOTE_IDLE_TIMEOUT_MS=900000
REMOTE_MAX_EDIT_BYTES=1048576
REMOTE_MAX_UPLOAD_BYTES=5368709120
REMOTE_MAX_PREVIEW_BYTES=262144
REMOTE_TERMINAL_BUFFER_BYTES=204800
REMOTE_TERMINAL_IDLE_MS=1800000
REMOTE_TERMINAL_MAX_SESSIONS=8
REMOTE_SEARCH_LIMIT=500
# CA kustom untuk FTPS (opsional, default: CA sistem)
# REMOTE_FTPS_CA_FILE=/root/certs/ca.pem
